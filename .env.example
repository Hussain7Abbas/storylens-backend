# Server
PORT="BACKEND-PORT"
NODE_ENV="NODE-ENV"

# Auth (BetterAuth)
BETTER_AUTH_SECRET="your-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3030"
# Website origin serving account pages (trusted for OAuth redirects, and the
# only origin whose requests may use the website session cookie)
WEBSITE_URL="http://localhost:3000"
# Development only: more website origins for the session cookie, comma-separated
WEBSITE_DEV_ORIGINS=""
# Development only: "true" drops Secure and the __Host- prefix from the website
# session cookie for plain-HTTP localhost. Refused in production.
WEB_SESSION_INSECURE_COOKIE=""
# Dashboard origin, linked from billing emails to the owner
DASHBOARD_URL="http://localhost:3040"
# Google sign-in: set both to enable it. Authorized redirect URI:
# {BETTER_AUTH_URL}/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Resend): registration verification codes. Outside production, codes
# are logged to the console when these are empty. EMAIL_FROM must use a domain
# verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Story Lens <noreply@mail.iscoded.com"

# Database
DATABASE_URL="postgresql://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_DOMAIN:POSTGRES_PORT/POSTGRES_DB"

# Dashboard super admin created by the seed (the dashboard has no sign-up).
# The email may be your existing reader account: it keeps its password and
# gains dashboard access. Otherwise a dashboard-only account is created with
# this username and password.
DASHBOARD_ADMIN_USERNAME="DASHBOARD-ADMIN-USERNAME"
DASHBOARD_ADMIN_PASSWORD="DASHBOARD-ADMIN-PASSWORD"
DASHBOARD_ADMIN_EMAIL="admin@example.com"

# Storage
STORAGE_IMGBB_API_KEY="STORAGE-IMGBB-API-KEY"

# AI (OpenRouter): Story Lens Cloud AI. Models are the AI_Text_Model and
# AI_Image_Model configs (dashboard Settings → AI); turn it on with AI_Cloud_Enabled.
OPENROUTER_API_KEY=""

# Chrome Web Store (review-version watcher deploys once this item publishes Review_Version)
CHROME_EXTENSION_ID=""

# GitHub fine-grained token (Contents: write on storylens-dashboard); the watcher deploys the dashboard after its sync
DASHBOARD_DISPATCH_TOKEN=""

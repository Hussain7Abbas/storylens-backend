generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator prismabox { 
  provider = "prismabox"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName = "t"
  inputModel = true
  output   = "./generated/prismabox"
} 

enum FileType {
  Image
  Video
}

// The two APIs: `admin` is the dashboard (`/api/admin`), `user` is the
// extension, website account pages and desktop client (`/api/user`).
enum Portal {
  admin
  user
}

enum MatchingType {
  FULL
  PARTIAL
}

model User {
  id String @id @default(uuid())

  // Credentials
  email         String  @unique
  emailVerified Boolean @default(false)
  username      String  @unique
  password      String

  // Profile
  name  String
  // Provider profile picture URL; Better Auth writes it on OAuth sign-up.
  image String?

  // Authorization: one account may use both APIs. Each flag enables a portal
  // and that portal's role grants the permissions there.
  isUser      Boolean @default(true)
  userRoleId  String?
  userRole    Role?   @relation("UserRole", fields: [userRoleId], references: [id], onDelete: SetNull)
  isAdmin     Boolean @default(false)
  adminRoleId String?
  adminRole   Role?   @relation("AdminRole", fields: [adminRoleId], references: [id], onDelete: SetNull)
  // Anonymous extension install; verified registration or OAuth clears it.
  isGuest     Boolean @default(false)

  avatarId String?
  avatar   File?   @relation(fields: [avatarId], references: [id], name: "UserAvatars")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  uploads         File[]
  novels          Novel[]          @relation("NovelCreator")
  keywords        Keyword[]        @relation("KeywordCreator")
  keywordAliases  KeywordAlias[]   @relation("KeywordAliasCreator")
  keywordVersions KeywordVersion[] @relation("KeywordVersionCreator")
  replacements    Replacement[]    @relation("ReplacementCreator")
  sessions        Session[]
  accounts        Account[]
}

// A named set of permissions for one portal. System roles (fixed slugs) are
// created by migrations and cannot be deleted; `super-admin` always holds
// every admin permission.
model Role {
  id String @id @default(uuid())

  slug        String  @unique
  name        String
  description String?
  portal      Portal
  isSystem    Boolean @default(false)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  permissions Permission[] @relation("RolePermissions")
  // A role is used through the relation matching its portal.
  readers     User[]       @relation("UserRole")
  admins      User[]       @relation("AdminRole")

  @@index([portal])
}

// One row per API endpoint (`METHOD /route/:template`) plus capability keys
// such as `user:moderate`. The server syncs endpoint rows from its routes on
// startup.
model Permission {
  id String @id @default(uuid())

  key         String  @unique
  portal      Portal
  group       String
  method      String?
  path        String?
  description String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  roles Role[] @relation("RolePermissions")

  @@index([portal])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The API this token was issued for; it is rejected by the other one.
  portal    Portal   @default(user)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model File {
  id String @id @default(uuid())

  url      String   @unique
  type     FileType
  provider_image_id String @unique
  delete_url String

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users           User[]           @relation("UserAvatars")
  novels          Novel[]          @relation("NovelImages")
  keywordVersions KeywordVersion[] @relation("KeywordVersionImages")
  keywordAliases  KeywordAlias[]   @relation("KeywordAliasImages")
}

model Novel {
  id String @id @default(uuid())

  // Translated fields: each language has its own column; readers only see their language's.
  nameAr        String? @unique
  nameEn        String? @unique
  descriptionAr String?
  descriptionEn String?
  // Setting, premise, tone and main cast summary that AI prompts use as the novel's global context.
  context String? @db.Text
  slugs String[] @default([])

  imageId String?
  image File? @relation(fields: [imageId], references: [id], name: "NovelImages")

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], name: "NovelCreator")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  Keywords Keyword[] @relation("NovelKeywords")
  chapters Chapter[] @relation("NovelChapters")
  replacements Replacement[] @relation("NovelReplacements")
  biases WebsiteNovelBias[]
}

model Chapter {
  id String @id @default(uuid())

  name String
  number Int
  description String?

  novelId String
  novel Novel @relation(fields: [novelId], references: [id], name: "NovelChapters", onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  KeywordsChapters KeywordsChapters[] @relation("KeywordsChapters")

  @@index([novelId])
}

model KeywordCategory {
  id String @id @default(uuid())

  nameEn String?
  nameAr String?
  color  String
  // Explains when to use it; the AI keyword suggestion reads this.
  description String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  keywordVersions KeywordVersion[] @relation("KeywordVersionCategories")
  keywordAliases  KeywordAlias[]   @relation("KeywordAliasCategories")
}

model KeywordNature {
  id String @id @default(uuid())

  nameEn String?
  nameAr String?
  color  String
  // Explains when to use it; the AI keyword suggestion reads this.
  description String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  keywordVersions KeywordVersion[] @relation("KeywordVersionNatures")
  keywordAliases  KeywordAlias[]   @relation("KeywordAliasNatures")
}

model Keyword {
  id           String       @id @default(uuid())
  // Translated names matched on pages in that language; at least one is set.
  nameAr       String?
  nameEn       String?
  matchingType MatchingType @default(FULL)
  fuzzyMatchArabicCharacters Boolean @default(true)

  novelId String
  novel   Novel  @relation(fields: [novelId], references: [id], name: "NovelKeywords", onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], name: "KeywordCreator")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  aliases          KeywordAlias[]     @relation("KeywordAliases")
  versions         KeywordVersion[]   @relation("KeywordVersions")
  KeywordsChapters KeywordsChapters[] @relation("KeywordsChapters")
  replacements     Replacement[]      @relation("KeywordReplacements")

  @@unique([nameAr, novelId])
  @@unique([nameEn, novelId])
  @@index([nameAr])
  @@index([nameEn])
}

model KeywordAlias {
  id            String       @id @default(uuid())
  // The alias in each language, like Keyword.nameAr/nameEn; at least one is set.
  nameAr        String?
  nameEn        String?
  description   String?
  matchingType  MatchingType @default(FULL)
  fuzzyMatchArabicCharacters Boolean @default(true)
  overrideStyle Boolean      @default(false)

  categoryId String?
  category   KeywordCategory? @relation(fields: [categoryId], references: [id], name: "KeywordAliasCategories")

  natureId String?
  nature   KeywordNature? @relation(fields: [natureId], references: [id], name: "KeywordAliasNatures")

  imageId String?
  image   File?   @relation(fields: [imageId], references: [id], name: "KeywordAliasImages")

  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], name: "KeywordAliases", onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], name: "KeywordAliasCreator")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([keywordId, nameAr])
  @@unique([keywordId, nameEn])
  @@index([keywordId])
}

model KeywordVersion {
  id              String  @id @default(uuid())
  description     String?
  startingChapter Int
  endingChapter   Int?

  categoryId String?
  category   KeywordCategory? @relation(fields: [categoryId], references: [id], name: "KeywordVersionCategories")

  natureId String?
  nature   KeywordNature? @relation(fields: [natureId], references: [id], name: "KeywordVersionNatures")

  imageId String?
  image   File?   @relation(fields: [imageId], references: [id], name: "KeywordVersionImages")

  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], name: "KeywordVersions", onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], name: "KeywordVersionCreator")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([keywordId, startingChapter])
  @@index([keywordId])
}

model KeywordsChapters{
  id String @id @default(uuid())

  keywordId String
  keyword Keyword @relation(fields: [keywordId], references: [id], name: "KeywordsChapters")

  chapterId String
  chapter Chapter @relation(fields: [chapterId], references: [id], name: "KeywordsChapters")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([keywordId, chapterId])
}

model Replacement{
  id String @id @default(uuid())

  from String
  to String
  matchingType MatchingType @default(FULL)

  novelId String
  novel Novel @relation(fields: [novelId], references: [id], name: "NovelReplacements", onDelete: Cascade)
  
  keywordId String?
  keyword Keyword? @relation(fields: [keywordId], references: [id], name: "KeywordReplacements")

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], name: "ReplacementCreator")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([from, novelId])
}

model Config {
  id String @id @default(uuid())

  key   String @unique
  value String @db.Text

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model WebsiteSelector {
  id String @id @default(uuid())

  website String @unique

  novelXpathValue String?
  novelXpathRegex String?
  novelUrlRegex   String?

  chapterXpathValue String?
  chapterXpathRegex String?
  chapterUrlRegex   String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  biases WebsiteNovelBias[]

  @@index([website])
}

model WebsiteNovelBias {
  id String @id @default(uuid())

  websiteSelectorId String
  websiteSelector   WebsiteSelector @relation(fields: [websiteSelectorId], references: [id], onDelete: Cascade)

  novelId String
  novel   Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  biasValue Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([websiteSelectorId, novelId])
  @@index([novelId])
  @@index([websiteSelectorId])
}

// Change feed for delta sync (`/api/user/sync/.../changes`), written by database
// triggers on every insert, update and delete of the synced tables (migration
// `sync_change_feed`), so route code, dashboard merges, cascades and bulk updates
// are all recorded. `seq` orders changes exactly; old rows are pruned by a cron.
model SyncChange {
  seq      BigInt   @id @default(autoincrement())
  // novel, keyword, keywordAlias, keywordVersion, replacement, websiteNovelBias, keywordCategory, keywordNature
  entity   String
  entityId String
  // The novel the row belongs to; null for lookups, and for children deleted with their keyword.
  novelId  String?
  // insert, update or delete
  op       String
  at       DateTime @default(now())

  @@index([novelId, seq])
  @@index([entity, seq])
}
